# ─────────────────────────────────────────────────────────────
# Next.js (.env.local) — written by `npx convex dev`
# ─────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment-123
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-123.convex.site
# Public URL of the site (used for canonical URLs, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Convex deployment env vars — set with `npx convex env set NAME value`
# (add --prod for production). NEVER put these in .env.local or the frontend.
# ─────────────────────────────────────────────────────────────
# SITE_URL=http://localhost:3000            # where auth redirects back to
# JWT_PRIVATE_KEY=... / JWKS=...            # node scripts/setup-auth-keys.mjs [--prod]
# MEDIA_SIGNING_SECRET=<openssl rand -hex 32>   # signs private document links
#
# Telegram media store (photos, videos, documents)
# TELEGRAM_BOT_TOKEN=<from @BotFather>      # secret — server only
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx           # private channel where the bot is admin
#
# Email OTP + notifications (optional; without it codes are printed in Convex logs)
# AUTH_RESEND_KEY=re_...
# AUTH_EMAIL_FROM="land.db <no-reply@yourdomain.com>"
# Phone OTP (optional; without it codes are printed in Convex logs)
# TWILIO_ACCOUNT_SID=... / TWILIO_AUTH_TOKEN=... / TWILIO_FROM=+1...
# Google sign-in (optional; button appears only when set)
# AUTH_GOOGLE_ID=... / AUTH_GOOGLE_SECRET=...
#
# ADMIN_EMAILS=you@example.com,other@example.com   # auto-admin on first sign-in
# VIDEO_REQUIRE_MODERATION=true             # hold new videos for admin review
# AUTH_DEV_OTP_CODE=246810                  # DEV/E2E ONLY — fixed OTP. Never on prod.

# Admin panel passcode (default: 808080)
ADMIN_PASSCODE=808080
